[Unit]
Description=ISC Kea IPv6 DHCP Server
Documentation=man:kea-dhcp6(8)
Wants=network-online.target mariadb.service
Requires=kea-ctrl-agent.service
After=network-online.target mariadb.service

[Service]
Environment="KEA_PIDFILE_DIR=/run"
Environment="KEA_CONTROL_SOCKET_DIR=/run/kea"
ExecStart=/usr/sbin/kea-dhcp6 -c /etc/kea/kea-dhcp6.conf

[Install]
WantedBy=multi-user.target
